# ════════════════════════════════════════════════════════════════════
# URM Platform — Environment Variables (.env.example)
# ════════════════════════════════════════════════════════════════════
# 본 파일은 src/lib/env.ts(zod 검증)에 정의된 전체 변수 목록입니다.
# 운영 시 .env.local, .env.production 등으로 복사 후 값만 치환하세요.
# Vercel 배포 시에는 Vercel Dashboard > Settings > Environment Variables
# 또는 `vercel env add <KEY>` CLI로 등록합니다.
# ════════════════════════════════════════════════════════════════════

# ─── 1. Anthropic ─────────────────────────────────────────────────
# 출처: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXX

# 모델 ID는 마스터 시스템 프롬프트가 z.literal()로 강제. 변경 금지.
ANTHROPIC_MODEL_OPUS=claude-opus-4-7
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6

# ─── 2. Supabase ──────────────────────────────────────────────────
# 출처: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# 출처: Project Settings > Database > Connection String (URI mode, pooler 권장)
SUPABASE_DB_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# 첨부파일용 버킷 — Supabase Dashboard > Storage > Buckets에서 사전 생성 필요
SUPABASE_STORAGE_BUCKET_ATTACHMENTS=communications-attachments

# ─── 3. OpenAI (임베딩 전용, 답장 생성에는 미사용) ─────────────────
# 출처: https://platform.openai.com → API Keys
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ─── 4. TABS Mailer 4 (자체 SMTP relay) ───────────────────────────
# 자체 인프라가 없는 경우, host에 'mock' 또는 'localhost'를 넣으면
# tabs-mailer.ts가 자동으로 mock 모드로 동작 (SMTP 호출 없이 console.log).
TABS_MAILER_HOST=smtp.tabs.example.com
TABS_MAILER_PORT=587
TABS_MAILER_AUTH_METHOD=login              # 'plain' | 'login' | 'ip_whitelist'
TABS_MAILER_USERNAME=                      # ip_whitelist 외에는 필수
TABS_MAILER_PASSWORD=                      # ip_whitelist 외에는 필수
TABS_MAILER_USE_TLS=true
TABS_MAILER_FROM_DOMAIN=mail.yourdomain.com
TABS_MAILER_FROM_DEFAULT=noreply@mail.yourdomain.com
# TABS_MAILER_DB_CONN 미설정 시, getCampaignStats는 communications 테이블에서 자체 집계 fallback
TABS_MAILER_DB_CONN=

# ─── 5. MailCarrier 7 (IMAP 수신) ─────────────────────────────────
# Gmail/Outlook IMAP을 임시로 사용하려면 host/port/계정만 갈아끼우면 됩니다.
MAILCARRIER_HOST=imap.mailcarrier.example.com
MAILCARRIER_PORT=993
MAILCARRIER_USERNAME=inbox@mail.yourdomain.com
MAILCARRIER_PASSWORD=YOUR_IMAP_PASSWORD
MAILCARRIER_USE_IDLE=true
MAILCARRIER_INBOX_FOLDER=INBOX
MAILCARRIER_POLL_INTERVAL_SECONDS=30

# ─── 6. 트래킹 ────────────────────────────────────────────────────
MAIL_DOMAIN=mail.yourdomain.com
TRACKING_BASE_URL=https://track.yourdomain.com

# ─── 7. 운영 정책 ─────────────────────────────────────────────────
# !!! 매우 중요: production 첫 배포 시 false 권장. UI에서 명시적 enable 후 true.
AI_AUTO_SEND_ENABLED=false
SCRAPING_ENABLED=true

# 비용 상한 (USD). 초과 시 ClaudeBudgetExceededError로 차단되고 ai.runs에 기록됨.
MAX_DAILY_AI_COST_USD=50
MAX_MONTHLY_AI_COST_USD=1500

DRAFT_EXPIRY_DAYS=7                        # ai.drafts.expires_at = NOW() + N일
CLAUDE_HARD_TIMEOUT_MS=60000               # Anthropic API 호출 타임아웃
CLAUDE_MAX_RETRIES=3                       # 429/5xx/timeout 재시도 횟수

# ─── 8. 인프라 ────────────────────────────────────────────────────
REDIS_URL=                                 # 미사용 가능 (큐는 Postgres LISTEN 기반)
NODE_ENV=production                        # development | test | preview | staging | production
LOG_LEVEL=info                             # debug | info | warn | error
SENTRY_DSN=                                # 권장: 프로덕션 에러 트래킹
SLACK_WEBHOOK_URL=                         # 옵션: 자동발송 차단/오류 알림용
