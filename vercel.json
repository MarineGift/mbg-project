{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/draft-expiry",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/process-pending-inbound",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/mail-merge",
      "schedule": "*/2 * * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/draft-expiry/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/process-pending-inbound/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/mail-merge/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/drafts/[id]/approve/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/webhooks/inbound/route.ts": {
      "maxDuration": 30
    }
  }
}
